# Database
# Default local mode. Use DB_PATH=auto to create the database under the user's app data directory.
DB_DRIVER=sqlite
DB_PATH=auto

# Advanced Postgres mode. Set DB_DRIVER=postgres and fill these values if you want to use Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=jobscraper
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Manila

DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/jobscraper?sslmode=disable&timezone=Asia/Manila

# HTTP server
PORT=8080

# Web UI
# Leave empty to use the embedded UI. Set to web during development to serve files from disk.
WEB_ROOT=

# Matcher / AI provider
# Supported providers: ollama, openai, anthropic, openai_compatible
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:3b
AI_API_KEY=

# Ollama thinking mode. Keep false unless your selected model supports it.
AI_THINK=false

MATCHER_WORKERS=1
MATCHER_BATCH_SIZE=100

# CV
# Keep real CV files out of git. This will become a UI-managed profile in the productized app.
CV_PATH=cv.text

# Debugging
# Set to true to log the first ~800 chars of raw model text before JSON parse.
# MATCHER_LOG_MODEL_RAW=true
