#DATABASE
DB_HOST=172.31.186.103
DB_PORT=5432
DB_USER=shinichikudo1st
DB_PASSWORD=myjobscraperengine
DB_NAME=jobscraper
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Tokyo

DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=<DB_SSLMODE>&timezone=<DB_TIMEZONE>
#SAMPLE: postgres://shinichikudo1st:myjobscraperengine@172.31.186.103:5432/jobscraper?sslmode=disable&timezone=Asia/Tokyo

#PORT
PORT=8080

#WEB UI (static files; run binary from repo root or set absolute path)
WEB_ROOT=web

#MATCHER
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Ollama thinking API: https://ollama.com/blog/thinking — omit or false for direct JSON in "response"
OLLAMA_THINK=false
MATCHER_WORKERS=1
CV_PATH=cv.text
# Set to true to log first ~800 chars of raw Ollama text before JSON parse (verbose)
# MATCHER_LOG_MODEL_RAW=true